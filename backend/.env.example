# --- Auth ---
# JWT imzalama anahtarı — üretimde MUTLAKA uzun, rastgele bir değerle değiştir.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# İlk açılışta oluşturulan varsayılan admin (yalnızca hiç kullanıcı yoksa).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Database ---
DATABASE_URL=sqlite:///./taskpilot.db

# --- CORS (virgülle ayrılmış origin listesi) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
